# Arcadia — Apache config for cPanel hosting.

# Short build links: /b/x7k2p is handled by the app, which fetches the build
# by id. Serving index.html directly (rather than redirecting) keeps the short
# URL in the address bar.
RewriteEngine On

# One canonical scheme and hostname. cPanel may already do this from its own
# panel setting, in which case this is a harmless no-op; if it does not, four
# variants of every URL serve the same page and split their own search signals.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^arcadia\.carl-prewitt\.com$ [NC]
RewriteRule ^ https://arcadia.carl-prewitt.com%{REQUEST_URI} [R=301,L]

RewriteRule ^b/([A-Za-z0-9]{4,12})/?$ /index.html [L]

# Item pages. One PHP template renders every item from items.json, which is
# generated from the same datasets the planner uses -- so an item search can
# reach a real page instead of a JavaScript app on a single URL.
RewriteRule ^items/?$ /item.php [L]
RewriteRule ^item/([a-z0-9-]{1,80})/?$ /item.php?slug=$1 [L,QSA]

# No directory listings anywhere, /api included.
Options -Indexes

# Belt and braces: this host happens to block dotfiles already, but don't rely
# on a host default to keep the repository metadata off the web.
RedirectMatch 404 /\.git(/|$)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Never expose database credentials, even if PHP is misconfigured.
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|example\.php)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # The moderation token is posted in a request body, so the site should never be
  # reached over plain http at all -- not even once, before the redirect above.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # The app is self-contained apart from one opt-in feature: importing gear from
  # a tooltip screenshot loads an OCR engine from jsDelivr, and only when someone
  # actually drops in an image. A visitor who never uses it makes no third-party
  # request. The screenshot itself never leaves the browser — recognition runs
  # locally in WebAssembly; only the engine and its language data are fetched.
  #
  # That feature needs six things the old policy denied, and every one of them
  # fails silently on the server while working fine from a local file, where no
  # policy applies at all:
  #   script-src  cdn.jsdelivr.net    the engine itself
  #   script-src  'wasm-unsafe-eval'  compiling WebAssembly counts as evaluating
  #                                   script. This is the narrow directive that
  #                                   permits only that -- plain 'unsafe-eval'
  #                                   would also re-open eval() and new Function
  #                                   for the whole page, which is not worth it
  #                                   for one import button.
  #   worker-src  blob:               recognition runs in a worker built from a blob
  #   connect-src both CDNs           the language data
  #   connect-src data:               the wasm core arrives as a data: URI and is
  #                                   read with fetch(). data: is not covered by
  #                                   'self' or by any host source, so it has to
  #                                   be named -- the same trap as the fonts below.
  #   img-src     blob:               the preview thumbnail shown before you confirm
  #
  # font-src needs data: because the webfonts are embedded in the page rather
  # than fetched — without it they fall back to default-src 'self', which does
  # not cover data: URIs, and every heading silently renders in a fallback face.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: https://cdn.jsdelivr.net https://tessdata.projectnaptha.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # index.html changes whenever the tool is updated, so don't cache it hard.
  ExpiresByType text/html "access plus 0 seconds"
  # The fonts are content-stable: same two faces every deploy. They used to be
  # base64 inside the page, which meant re-downloading them on every visit.
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>
